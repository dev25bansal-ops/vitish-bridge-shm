# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.npy
*.npz
*.pt
*.onnx
models/weights/*.pkl
# Per-structure weight dirs (hbta_accel/, hbta_strain/) hold the same artifact
# types — the top-level *.pkl rule only matches one level deep
models/weights/*/*.pkl
# Pre-retrain weight backups (one-off, re-generable)
models/weights/bak-*/
!models/weights/.gitkeep
# YOLO training runs (batch-preview images + weights are bulk and re-generable;
# the trained weights under models/weights/*.pt are separately ignored)
models/weights/yolo_runs/
data/z24/*
!data/z24/.gitkeep

# Real CV datasets (large, re-downloadable; see scripts/download_dacl10k.py)
data/cv/*
!data/cv/.gitkeep

# Real vibration datasets (large; HBTA h5 2.5GB, Z24 under data/z24/)
data/vib/*
!data/vib/.gitkeep

# Real LTBP fleet data (large raw exports, re-downloadable from FHWA InfoBridge;
# small derived artifacts in data/ltbp/analysis/ are committed)
data/ltbp/*.txt
!data/ltbp/.gitkeep

# Node / twin
node_modules/
twin/dist/
twin/.vite/

# Docker
docker-data/

# Secrets / env
.env
*.env.local
# Hosted-demo secrets (deploy/hosted-demo/.env.public — the example is committed)
deploy/hosted-demo/.env.public

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/

# Research scratch (kept locally, not committed)
*.json
!docker-compose.yml
!package.json
!data/ltbp/analysis/*.json
# Item 21 (fleet-prior learning loop): the DERIVED merged summary is a
# generated artifact of scripts/ltbp_merge.py — its regeneration is the
# committed command; never commit the merged output itself.
data/ltbp/analysis/ltbp_summary.generated.json

# Research diagnostic dumps (raw web fetches; the distilled summaries in
# .verify/*.txt / vault are what teammates need)
.verify/*.html
.verify/*.xml
.verify/cf_readme.txt
.verify/cj.txt
.verify/sut_loaders.py
# Headless-browser verification artifacts (screenshots/DOM dumps can carry
# transient Cesium ion URLs — never commit them)
.verify/*.log
.verify/*.png
.verify/*.jpg
.verify/*_dom.html
.verify/geo_verify.cjs
.verify/arc_calib.py
# Diagnostic probe scripts (superseded by backend/tests/* when promoted)
.verify/*.py
.verify/*.ps1
# Large/transient headless-browser + upload artifacts — never commit
.verify/chrome-geo-profile/
.verify/hf_parts/

# Vendor tooling for the ESP edge node (downloaded binaries/drivers/logs — keep
# on disk for the hardware work, never commit; only the human-authored helper
# scripts under tools/ are tracked)
tools/arduino-cli/arduino-cli.exe
tools/arduino-cli/arduino-cli.zip
tools/esp/*.bin
tools/esp/*.zip
tools/esp/*.log
tools/esp/cp210x_drv/
tools/esp/driver_install.log

# HBTA per-structure retrain — the tar (2.4 GB, data_100Hz.h5 inside) and the
# dist/ staging copy are rebuildable artifacts; only the source scripts under
# tools/hbta_retrain/ are tracked. Scratch training outputs (*_out/, *_weights/)
# hold .npy (ignored above) + *.pt/*.pkl (ignored above).
/hbta_retrain_*.tar.gz
tools/hbta_retrain/dist/
tools/hbta_retrain/*_out/

# OS
Thumbs.db
.DS_Store

# ---------------------------------------------------------------------------
# PostHackathon TEST-F3: COMMITTED trained artifacts + real-Z24 fixture so the
# trained-ML gates (`test_trained_path.py`, `test_deconfounding.py` LEG C) run
# on a fresh clone / CI instead of silently skipping.  Re-ignored: the big
# retrainable weights (crack_seg.pt, hbta_*/, yolo_runs/) and the full 991 MB
# Z24 benchmark (data/z24/inputs.npy + labels.npy).
!models/weights/vae.pt
!models/weights/ocsvm.pkl
!models/weights/scaler.pkl
!models/weights/lstm_ae.pt
!models/weights/train_meta.json
!models/weights/lstm_ae_meta.json
!data/z24/fixture/
!data/z24/fixture/*.npy

# Item-17 scale/temp retrain CANDIDATE + scratch output dirs.  Only artifacts
# actually installed into models/weights/ (the shipped set above) are tracked;
# experiments in weights_scratch/ / weights_scale_temp/ are never committed.
/models/weights_scratch/
/models/weights_scale_temp/

# Re-generated demo artifacts (condition-report samples) — not committed
/docs/samples/
