# VITISH SHM digital-twin environment template.
# Copy to `.env` and fill in.  `.env` is gitignored — never commit real tokens.

# Cesium ion access token (free Standard tier) — powers the D2-7 georeferenced
# context layer (terrain, 3D Tiles, OSM Buildings).  Leave empty to run the twin
# without the georeferenced layer.
VITE_CESIUM_TOKEN=

# Optional overrides for backend endpoint discovery.  Normally the twin asks the
# backend for its actually-bound ports via GET /api/config (see src/lib/config.ts);
# these bypass discovery for a non-local or fixed-port deployment.
VITE_API_BASE=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8765
